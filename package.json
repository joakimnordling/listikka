{
  "name": "listikka",
  "version": "0.1.0",
  "private": true,
  "description": "A shared shopping list that syncs end-to-end encrypted through a server you choose.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/build-icons.js",
    "app-icons": "node scripts/build-app-icons.js",
    "build": "node scripts/build-site.js",
    "serve": "node scripts/serve.js",
    "screenshots": "node scripts/screenshots.js",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "lint": "biome check .",
    "test:e2e": "node scripts/build-site.js && node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:sync": "node --test \"tests/sync/**/*.test.js\""
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "fractional-indexing": "3.2.0",
    "hash-wasm": "4.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@fontsource-variable/jost": "5.3.0",
    "@napi-rs/image": "1.16.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.68.0",
    "playwright": "1.63.0",
    "qr-scanner": "1.4.2",
    "ws": "8.18.3"
  }
}
